<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <RootNamespace>EchoUI.Render.WebGPU</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EchoUI.Core\EchoUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Alimer.Bindings.WebGPU" Version="1.6.0" />
    <PackageReference Include="Alimer.WebGPU.Native" Version="1.0.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Shaders\*.wgsl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
